# ============================================================
# CivicConnect — Root .env.example
# Copy to .env and fill in values
# ============================================================

# Google Gemini API (Multimodal AI Triage Agent for WhatsApp images, audio, text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API (Webhook & Automated Citizen Notification)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=civicconnect_verify_token

# NVIDIA API (optional fallback for DNA analysis)
NVIDIA_API_KEY=

# SMTP (optional — notification-service logs to console if not set)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

