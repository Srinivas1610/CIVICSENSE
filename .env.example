# NVIDIA API (optional — DNA engine uses mock if not set)
NVIDIA_API_KEY=

# SMTP (optional — notification-service logs to console if not set)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
